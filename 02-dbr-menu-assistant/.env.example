OPENROUTER_API_KEY=paste-your-openrouter-key-here
# Optional: a different model (default anthropic/claude-haiku-5.5)
# LLM_MODEL=openrouter/free
# Optional: let the model think before answering (off by default; costs more, see README)
# LLM_REASONING=on
# Optional: shared secret the API expects in the X-API-Token header
# ASSISTANT_API_TOKEN=
